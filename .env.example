# ─── Database (PostgreSQL) ───────────────────────────────────────────────
# Local dev: a local Postgres instance. Production: your Hostinger VPS Postgres.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/sapphire?schema=public"

# ─── Auth.js (NextAuth v5) ───────────────────────────────────────────────
# Generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET="replace-me-with-a-32-byte-random-string"
NEXTAUTH_URL="http://localhost:3000"

# Google OAuth (https://console.cloud.google.com → Credentials → OAuth client ID)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# ─── CMS / enterprise features (all optional) ────────────────────────────
# Canonical public URL — powers sitemap.xml, robots.txt, OG tags and redirects.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# AI content assistant (blog drafts + SEO meta). Leave blank to disable the AI buttons.
ANTHROPIC_API_KEY=""

# Secret guarding the scheduled-publishing cron (/api/cron/publish?secret=…).
CRON_SECRET=""

# ─── Order emails / SMS (optional) ───────────────────────────────────────
# Transactional email for order invoices & tracking (Resend HTTP API).
# Without these, the "Email Invoice/Tracking" buttons show a clear message.
RESEND_API_KEY=""
EMAIL_FROM="Sapphire Vibes <orders@sapphirevibes.com>"

# Optional order SMS via Twilio.
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM=""

# ─── Stripe payments (optional) ───────────────────────────────────────────────
# Without STRIPE_SECRET_KEY the store behaves as before: card/wallet orders are
# marked PAID at checkout with no charge taken. With it set, those methods are
# routed through Stripe Checkout and only the webhook marks an order PAID.
# Webhook endpoint: POST /api/webhooks/stripe
#   events: checkout.session.completed, checkout.session.expired,
#           checkout.session.async_payment_failed
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Releases abandoned gateway checkouts (stock, coupons, gift cards, points).
# Cron every 10 min:  curl -s "https://yourdomain.com/api/cron/release-unpaid?secret=$CRON_SECRET"
